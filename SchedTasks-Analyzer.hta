/* async: ~1500 events per tick, slice after slice; the UI stays live and shows progress */
function parseEvents(){
  var R=RUN;
  try{
    if(!R.evCur){
      if(!R.evQ.length){ window.setTimeout(joinAndWrite, 10); return; }
      var root=R.evQ[0];
      root.evt=root.evt||{list:[], span:{}, defs:{}, last:{}, kept:0, cut:0};
      while(root.evtXml.length && !R.evCur) R.evCur=openEvtExport(root, root.evtXml.shift());
      if(!R.evCur){ R.evQ.shift(); window.setTimeout(parseEvents, 1); return; }
    }
    var cur=R.evCur, evt=cur.root.evt, wd=winKey(cur.root), left=1500, more=true;
    while(left>0){
      if(cur.total>=EVT_MAX_EVENTS){ more=false; break; }                // the query is capped already; this is the backstop
      if(cur.i>=cur.len){ if(!(more=evtNextSlice(cur))) break; continue; }
      var nd=cur.nodes[cur.i++]; if(nd.nodeType!==1) continue; left--; cur.total++;
      var ev=evtFromNode(nd, cur.x.log, cur.x.src, wd);
      if(ev && ev.task){ evtKeep(evt, ev); evt.list.push(ev); cur.n++; if(ev.ts && (!cur.lo || ev.ts<cur.lo)) cur.lo=ev.ts; } }
    var pct=(cur.rd && cur.rd.st && cur.rd.size)?(" ("+Math.floor(100*cur.rd.st.Position/cur.rd.size)+"%)"):"";
    setStatus("Reading the "+cur.x.log+" event log... "+nf(cur.total)+" events"+pct,"muted");
    if(!more){ evtExportDone(cur); R.evCur=null; if(!cur.root.evtXml.length) R.evQ.shift(); }
    window.setTimeout(parseEvents, 1);
  }catch(ex){ if(R.evCur && R.evCur.rd) evtReaderClose(R.evCur.rd); R.warn.push("Event-log parsing failed: "+ex.message); R.evQ=[]; R.evCur=null; window.setTimeout(joinAndWrite, 10); }
}
/* events of one collection -> per-task summaries (key = normalized task path) */

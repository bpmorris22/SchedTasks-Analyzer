    var d=newDom(), ok=false; if(!d) throw new Error("MSXML is not available");
    try{ ok=d.loadXML("<Events>"+s+"</Events>"); }catch(e){ ok=false; }
    if(!ok || !d.documentElement){ cur.bad++; if(!cur.badWhy && d.parseError) cur.badWhy=trimStr(d.parseError.reason); continue; }   // skip it, keep going
    cur.dom=d; cur.nodes=d.documentElement.childNodes; cur.len=cur.nodes.length; return true; }

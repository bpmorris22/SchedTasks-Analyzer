    su.nRuns=su.n100||su.n200||su.n129;
    var rt=[]; for(j=0;j<su.evts.length;j++){ var ej=su.evts[j]; if(ej.id===100 || (!su.n100 && (ej.id===200 || ej.id===129))) rt.push(ej.ts); }
    su.firstRun=rt.length?rt[0]:""; su.lastRun=rt.length?rt[rt.length-1]:"";

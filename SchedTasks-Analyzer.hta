  if(/^\\?NT TASK\\/i.test(o.task)) o.task="\\"+o.task.replace(/^\\?NT TASK\\/i,"");
  o.user=d.UserContext||d.UserName||(d.SubjectUserName?((d.SubjectDomainName?(d.SubjectDomainName+"\\"):"")+d.SubjectUserName):"");

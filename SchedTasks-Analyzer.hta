      var a=trimStr(ea.action), al=a.toLowerCase(); if(seen[al]) continue; seen[al]=1; imgs.push(a); }
    for(j=0;j<imgs.length;j++){ if(/[\\\/]/.test(imgs[j])) full[launcherName(imgs[j])]=1; }
    for(j=0;j<imgs.length;j++){ if(!/[\\\/]/.test(imgs[j]) && full[launcherName(imgs[j])]) continue; keep.push(imgs[j]); }
    su.imgs=keep; }

function cpByte(c){ if(c<0x80 || (c>=0xA0 && c<=0xFF)) return c;
  if(!CP1252_REV){ CP1252_REV={}; for(var i=0;i<32;i++) CP1252_REV[CP1252_HI[i]]=0x80+i; }

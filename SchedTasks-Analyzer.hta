    else if(id===100){ if(e.inst && !s.inst100[e.inst]){ s.inst100[e.inst]=1; s.n100++; } s.runs.push(e.ts); s.ranSince=true; if(e.user) s.runUser=e.acct||e.user; }
    else if(id===200){ if(e.inst && !s.inst200[e.inst]){ s.inst200[e.inst]=1; s.n200++; } s.ranSince=true; }
    else if(id===129){ s.n129++; s.ranSince=true; } }

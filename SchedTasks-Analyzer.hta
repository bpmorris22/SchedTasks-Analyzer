var ACCT_WK={"SYSTEM":1,"LOCAL SERVICE":1,"NETWORK SERVICE":1};
function acctId(a){ a=trimStr(String(a||"")); if(!a) return null;
  var w=wellKnown(a); if(ACCT_WK[w]) return {wk:w};
  a=a.toLowerCase(); var bs=a.lastIndexOf("\\");
  if(bs>=0) return {dom:a.substring(0,bs), name:a.substring(bs+1)};
  return (a.indexOf("@")>0)?{upn:a}:{name:a}; }
/* 1 = the same account, -1 = a different one, 0 = cannot tell */
function acctCmp(a,b){ var x=acctId(a), y=acctId(b);
  if(!x || !y) return 0;

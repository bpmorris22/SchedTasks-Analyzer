      // An unknown run or delete account (no 100 UserContext, ambiguous names) goes in neither - it proves nothing
      if(s.regAt && s.ranSince && e.ms>=s.regAt){ var g=e.ms-s.regAt, ac=acctCmp(s.runUser, e.acct||e.user);
        if(ac>0){ if(s.selfGap<0 || g<s.selfGap) s.selfGap=g; } else if(ac<0 && (s.gap<0 || g<s.gap)) s.gap=g; }

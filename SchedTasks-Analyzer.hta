    // (the deletion stays in s.del as history); lifeTs = when that last lifecycle event happened
    if(id===106 || id===4698){ if(!s.reg) s.reg=e; s.life="reg"; s.lifeTs=e.ts; s.regAt=e.ms; s.ranSince=false; s.runUser=""; if(e.content){ s.content=e.content; s.contentId=id; } }
    else if(id===140 || id===4702){ s.upd=e; s.life="reg"; s.lifeTs=e.ts; s.regAt=e.ms; s.ranSince=false; s.runUser=""; if(e.content){ s.content=e.content; s.contentId=id; } }
    else if(id===141 || id===4699){ s.del=e; s.life="del"; s.lifeTs=e.ts;

function evtReaderPart(rd){ var k=Math.min(65536, EVT_SLICE_CHARS); if(rd.st) return rd.st.EOS?"":rd.st.ReadText(k); return rd.ts.AtEndOfStream?"":rd.ts.Read(k); }
function evtReaderClose(rd){ try{ if(rd.st) rd.st.Close(); }catch(e){} try{ if(rd.ts) rd.ts.Close(); }catch(e2){} rd.st=null; rd.ts=null; }

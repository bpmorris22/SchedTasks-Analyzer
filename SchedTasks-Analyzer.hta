/* windows-1252 code points of bytes 80-9F as ADODB "iso-8859-1" reads them (the five undefined bytes pass through) */
var CP1252_HI=[0x20AC,0x81,0x201A,0x192,0x201E,0x2026,0x2020,0x2021,0x2C6,0x2030,0x160,0x2039,0x152,0x8D,0x17D,0x8F,

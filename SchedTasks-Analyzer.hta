   (access denied on the live Security log, an unreadable / corrupt evtx) and must say so - otherwise the run ends "ok"
   with that log silently missing from the correlation */
function openEvtExport(root, x){
  var R=RUN, qf=(x.q!=null && x.q!==0), cur;
  if(x.old) root.evt.span[x.log]=evtSpan(x);
  if(qf) R.warn.push("wevtutil could not query the "+x.log+" log for root "+root.n+" ("+(x.q<0?"no exit code recorded":("exit "+x.q+(x.q===5?" - access denied":"")))+") - its task events are missing or incomplete; see the log.");
  if(!fileExists(x.f)){ appendLog("Root "+root.n+": "+x.log+" - "+(qf?"query failed":"no task events (no export - see the log for the wevtutil error)")); return null; }
  cur={root:root, x:x, rd:null, nodes:null, dom:null, i:0, len:0, n:0, total:0, bad:0, badWhy:"", lo:""};

function evtExportDone(cur){
  var R=RUN, x=cur.x, root=cur.root, sp=root.evt.span[x.log], qf=(x.q!=null && x.q!==0), rd=cur.rd;
  if(rd) evtReaderClose(rd);
  cur.nodes=null; cur.dom=null;
  if(cur.bad) R.warn.push(nf(cur.bad)+" part(s) of the "+x.log+" event export for root "+root.n+" could not be parsed"+(cur.badWhy?(" ("+cur.badWhy+")"):"")+" - the events in them are skipped.");
  if(rd && /<Event[\s>]/.test(rd.tail)) R.warn.push("The "+x.log+" event export for root "+root.n+" ends inside an event (cut off?) - the events before it were read.");
  if(cur.total>=EVT_MAX_EVENTS) R.warn.push("The "+x.log+" log for root "+root.n+" reached the "+nf(EVT_MAX_EVENTS)+"-event cap: only its newest "+nf(EVT_MAX_EVENTS)+" task events were read (back to "+cur.lo.substring(0,19)+" UTC) - older ones are not correlated; run Hayabusa-Wrapper on this log.");
  if(!cur.total) appendLog("Root "+root.n+": "+x.log+" - "+(qf?"query failed":"no task events"));
  else appendLog("Root "+root.n+": "+x.log+" - "+nf(cur.n)+" task event(s)"+(sp&&sp.old?(", log covers "+sp.old+" -> "+sp.nw+" UTC"):""));
}
/* TaskContent (the whole task XML in 4698 / 4702) is ~2-5 KB per event and dominated memory. Each task's LATEST definition
   is always kept (evt.defs - what fillEvt recovers a definition from). Per event, a definition identical to the task's
   previous one shares that string; distinct ones are kept until EVT_CONTENT_MAX characters, after which the event's copy
   is dropped (ev.contentCut - the companion CSV says so). */
function evtKeep(evt, ev){

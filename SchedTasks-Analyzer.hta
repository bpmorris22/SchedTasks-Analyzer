}
var DEFCOLS=["Author","Description","Uri","RegDate","Source","SecurityDescriptor","XmlVersion","RunAs","LogonType","RunLevel","Enabled","Hidden",
  "DeleteExpired","TriggerCount","TriggerTypes","TriggerSummary","StartBoundary","EndBoundary","MinRepetition","ActionCount","ActionType",
  "Command","Arguments","WorkingDir","ComClassId","ComData","AllActions","ActionCommands"];
function fillEvt(row, s){
  row.EvtStatus=s.status; row.EvtEvents=String(s.evts.length); row.EvtRuns=String(s.nRuns);
  row.EvtRegisteredUtc=s.reg?s.reg.ts.substring(0,19):""; row.EvtRegisteredBy=s.reg?s.reg.user:"";
  row.EvtUpdatedUtc=s.upd?s.upd.ts.substring(0,19):"";
  row.EvtDeletedUtc=s.del?s.del.ts.substring(0,19):""; row.EvtDeletedBy=s.del?s.del.user:"";
  row.EvtDeleteGapSecs=(s.gap>=0)?String(Math.round(s.gap/100)/10):""; row.EvtSelfDeleteGapSecs=(s.selfGap>=0)?String(Math.round(s.selfGap/100)/10):"";
  row.EvtFirstRunUtc=s.firstRun.substring(0,19); row.EvtLastRunUtc=s.lastRun.substring(0,19);
  row._evtLast=s.lifeTs?s.lifeTs.substring(0,19):"";                  // not a CSV column: only feeds ChangedUtc in joinAndWrite

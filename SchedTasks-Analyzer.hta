function evtSummaries(list, defs){   // defs: per-task latest TaskContent (evtKeep) - wins over the events' own copies, which may be dropped
  var by={}, out=[], i, j;
  list.sort(function(a,b){ return a.t<b.t?-1:(a.t>b.t?1:((+a.rec||0)-(+b.rec||0))); });
  for(i=0;i<list.length;i++){ var e=list[i], k=normTaskPath(e.task), s=by[k], id=e.id;
    if(!s){ s=by[k]={key:k, disp:(e.task.charAt(0)==="\\"?"":"\\")+e.task, evts:[], src:{}, life:"", regAt:0, ranSince:false, runUser:"", gap:-1, selfGap:-1, inst100:{}, inst200:{}, n100:0, n200:0, n129:0, runs:[]}; out.push(s); }
    s.evts.push(e); s.src[e.src]=1;

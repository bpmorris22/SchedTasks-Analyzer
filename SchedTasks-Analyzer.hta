function evtText(n){ try{ return String(n.text); }catch(e){ return ""; } }
function evtFromNode(ev, log, src, wd){
  var sys=null, ed=null, c;
  for(c=ev.firstChild; c; c=c.nextSibling){ if(c.nodeType!==1) continue; var nm=nodeName(c); if(nm==="System") sys=c; else if(nm==="EventData") ed=c; }
  if(!sys) return null;
  var o={id:0, t:"", rec:"", log:log, src:src, wd:wd}, d={};
  for(c=sys.firstChild; c; c=c.nextSibling){ if(c.nodeType!==1) continue; var sn=nodeName(c);
    if(sn==="EventID") o.id=parseInt(evtText(c),10)||0;
    else if(sn==="TimeCreated") o.t=String(c.getAttribute("SystemTime")||"");
    else if(sn==="EventRecordID") o.rec=evtText(c); }
  if(ed){ for(c=ed.firstChild; c; c=c.nextSibling){ if(c.nodeType!==1) continue; var dn=c.getAttribute("Name"); if(dn) d[dn]=evtText(c); } }
  o.task=trimStr(d.TaskName||"");

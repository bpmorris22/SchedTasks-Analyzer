    if(/^\\microsoft\\/.test(b.path) && !b.inTasks && !b.del && b.index==="0") continue;   // stale Microsoft leftover there too
    var k=b.path+(st==="deleted"?"|rbdel":"|rb")+(other?("|"+b.guid):""); if(tc.byKey[k]) continue;   // never joined to the XML of that path
    b.rbOnly=true; b.rbStatus=st; b.key=k; tc.byKey[k]=b; tc.all.push(b); nAdd++; if(st==="deleted") nDel++; if(other) nOther++; }
  appendLog("Root "+root.n+": RegBack copy ("+(tc.rbUtc||"time unknown")+") - "+rb.all.length+" task entries; "+nMark+" also in the current hive, "+(nAdd-nDel)+" registered there but gone now, "+nDel+" deleted keys recovered from its slack"
